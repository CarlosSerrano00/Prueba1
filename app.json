{
  "expo": {
    "name": "AquaRuta",
    "slug": "aquaruta-lecturas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aquaruta",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.edu.esfot.aquaruta",
      "infoPlist": {
        "NSCameraUsageDescription": "AquaRuta usa la cámara para fotografiar el medidor como respaldo de la lectura.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ec.edu.esfot.aquaruta",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5B5BD6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B5BD6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "AquaRuta usa la cámara para fotografiar el medidor como respaldo de la lectura.",
          "photosPermission": "AquaRuta no accede a tu galería; la foto se toma con la cámara.",
          "microphonePermission": false
        }
      ],
      "./plugins/withCleartextTraffic",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cf7c392a-630a-4211-9e66-d4872029a66d"
      },
      "router": {}
    },
    "owner": "carlosserrano00"
  }
}
