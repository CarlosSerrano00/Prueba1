# URL raíz del sistema de oficina.
# La app agrega /medidores y /lecturas; no incluyas /recursos en la URL.
#
# Ejemplos:
#   MockAPI del proyecto:  https://6ae0a4a2be3bc8fead97a3b2.mockapi.io
#   Servidor local:        http://10.0.2.2:4000
#
# Si se deja vacío, la app usa la URL guardada desde Perfil o el valor
# por defecto https://6ae0a4a2be3bc8fead97a3b2.mockapi.io.
EXPO_PUBLIC_API_URL=

# Firebase Authentication (Firebase Console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
